<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Exclui o banco local e as chaves de API cifradas (DataStore) do backup e da transferência. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="ipmet_radar_weather.db" />
        <exclude domain="database" path="ipmet_radar_weather.db-shm" />
        <exclude domain="database" path="ipmet_radar_weather.db-wal" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="ipmet_radar_weather.db" />
        <exclude domain="database" path="ipmet_radar_weather.db-shm" />
        <exclude domain="database" path="ipmet_radar_weather.db-wal" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
